{
  "name": "kadr",
  "productName": "Kadr",
  "version": "0.1.0",
  "description": "Кадр — простой и красивый видеоредактор с ИИ-помощником",
  "author": {
    "name": "Максим (krasking94)"
  },
  "license": "MIT",
  "private": true,
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build:main": "node scripts/build-main.mjs",
    "build:renderer": "vite build",
    "build": "npm run build:renderer && npm run build:main",
    "start": "npm run build && electron .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node scripts/test.mjs",
    "ffmpeg": "node scripts/fetch-ffmpeg.mjs",
    "dist:win": "npm run build && electron-builder --win --x64 --publish never"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "0.133.0",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@types/node": "22.15.30",
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.6",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "44.7.0",
    "electron-builder": "26.17.0",
    "esbuild": "0.28.2",
    "lucide-react": "1.56.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "zod": "4.6.7",
    "zustand": "5.0.15"
  },
  "homepage": "https://github.com/krasking94/kadr-editor",
  "repository": {
    "type": "git",
    "url": "https://github.com/krasking94/kadr-editor.git"
  },
  "build": {
    "appId": "io.github.krasking94.kadr",
    "productName": "Kadr",
    "executableName": "Kadr",
    "copyright": "© 2026 Максим (krasking94). Лицензия MIT.",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "dist-electron/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/ffmpeg/win32",
        "to": "ffmpeg",
        "filter": [
          "*.exe",
          "*.dll",
          "LICENSE*"
        ]
      }
    ],
    "fileAssociations": [
      {
        "ext": "kadr",
        "name": "KadrProject",
        "description": "Проект «Кадр»",
        "role": "Editor"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "artifactName": "Kadr-${version}-win-x64.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Кадр",
      "uninstallDisplayName": "Кадр — видеоредактор",
      "artifactName": "Kadr-Setup-${version}.${ext}",
      "installerLanguages": [
        "ru_RU",
        "en_US"
      ],
      "language": "1049"
    }
  }
}
